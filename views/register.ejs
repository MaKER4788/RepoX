<%- include("partials/header") %>

<section class="min-h-[calc(100vh-80px)] flex items-center justify-center py-16 px-6">

    <div class="w-full max-w-md">

        <!-- Card -->
        <div
            class="rounded-3xl border border-slate-800 bg-slate-900/60 backdrop-blur-xl shadow-2xl shadow-blue-500/10 p-8">

            <!-- Logo -->
            <div class="text-center mb-8">

                <h1 class="text-4xl font-extrabold tracking-tight">
                    <span class="text-white">Repo</span><span
                        class="bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">X</span>
                </h1>

                <p class="text-slate-400 mt-3">
                    Create your account and start selling projects.
                </p>

            </div>

            <!-- Form -->
            <form action="/register" method="POST" class="space-y-5">

                <!-- Full Name -->
                <div>
                    <label class="block text-sm mb-2 text-slate-300">
                        Full Name
                    </label>

                    <input
                        type="text"
                        name="fullname"
                        placeholder="John Doe"
                        required
                        class="w-full rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white outline-none focus:border-blue-500 transition">
                </div>

                <!-- Username -->
                <div>
                    <label class="block text-sm mb-2 text-slate-300">
                        Username
                    </label>

                    <input
                        type="text"
                        name="username"
                        placeholder="johndoe"
                        required
                        class="w-full rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white outline-none focus:border-blue-500 transition">
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-sm mb-2 text-slate-300">
                        Email
                    </label>

                    <input
                        type="email"
                        name="email"
                        placeholder="john@gmail.com"
                        required
                        class="w-full rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white outline-none focus:border-blue-500 transition">
                </div>

                <!-- Age -->
                <div>
                    <label class="block text-sm mb-2 text-slate-300">
                        Age
                    </label>

                    <input
                        type="number"
                        name="age"
                        placeholder="20"
                        class="w-full rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white outline-none focus:border-blue-500 transition">
                </div>

                <!-- Password -->
                <div>
                    <label class="block text-sm mb-2 text-slate-300">
                        Password
                    </label>

                    <input
                        type="password"
                        name="password"
                        placeholder="••••••••"
                        required
                        class="w-full rounded-xl bg-slate-950 border border-slate-700 px-4 py-3 text-white outline-none focus:border-blue-500 transition">
                </div>

                <!-- Button -->
                <button
                    type="submit"
                    class="w-full py-3 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:scale-[1.02] transition-all duration-300 font-semibold shadow-lg shadow-blue-600/30">

                    Create Account

                </button>

            </form>

            <!-- Divider -->
            <div class="flex items-center my-6">
                <div class="flex-1 h-px bg-slate-800"></div>
                <span class="px-4 text-slate-500 text-sm">OR</span>
                <div class="flex-1 h-px bg-slate-800"></div>
            </div>

            <!-- Login -->
            <p class="text-center text-slate-400">

                Already have an account?

                <a href="/login"
                    class="text-blue-400 hover:text-blue-300 font-medium transition">

                    Login

                </a>

            </p>

        </div>

    </div>

</section>

<%- include("partials/footer") %>