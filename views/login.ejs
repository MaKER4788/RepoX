<% pageTitle = 'Login'; pageDescription = 'Log in to your RepoX account.'; %><%- include("partials/header") %>

<section class="min-h-[calc(100vh-60px)] flex items-center justify-center py-16 px-6">
    <div class="w-full max-w-md">
        <div class="rounded-xl border-white/10 border border-solid bg-neutral-900 p-8">
            <div class="text-center mb-6">
                <a href="/" class="inline-flex items-center gap-2">
                    <div class="size-8 bg-[oklch(0.55_0.19_255)] rounded-lg flex justify-center items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                    </div>
                    <span class="font-bold text-lg">RepoX</span>
                </a>
                <p class="text-[#a1a1a1] text-sm mt-3">Welcome back. Login to your account.</p>
            </div>
            <form action="/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-sm mb-1 text-[#a1a1a1]">Username</label>
                    <input type="text" name="username" placeholder="johndoe" required class="w-full rounded-lg bg-neutral-800 border-white/10 border border-solid px-4 py-2.5 text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)] transition">
                </div>
                <div>
                    <label class="block text-sm mb-1 text-[#a1a1a1]">Password</label>
                    <input type="password" name="password" placeholder="••••••••" required class="w-full rounded-lg bg-neutral-800 border-white/10 border border-solid px-4 py-2.5 text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)] transition">
                </div>
                <button type="submit" class="w-full py-2.5 rounded-lg bg-[oklch(0.55_0.19_255)] font-medium text-sm hover:opacity-90 transition">Login</button>
            </form>
            <div class="flex items-center my-5">
                <div class="flex-1 h-px bg-white/10"></div>
                <span class="px-3 text-[#a1a1a1] text-xs">OR</span>
                <div class="flex-1 h-px bg-white/10"></div>
            </div>
            <p class="text-center text-[#a1a1a1] text-sm">
                Don't have an account? <a href="/register" class="text-[oklch(0.65_0.16_255)] font-medium hover:opacity-80 transition">Create Account</a>
            </p>
        </div>
    </div>
</section>

<%- include("partials/footer") %>
