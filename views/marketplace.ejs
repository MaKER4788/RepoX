<% pageTitle = 'Marketplace'; pageDescription = 'Browse and buy code repositories, templates, and developer tools on RepoX.'; %><%- include("partials/header") %>

<main class="px-8 py-6">
    <div class="mb-5">
        <h1 class="font-bold text-2xl leading-8 tracking-tight mb-1">Explore Projects</h1>
        <p class="text-[#a1a1a1] text-sm leading-5">Discover production-ready software, templates and developer tools.</p>
    </div>
    <%- include("partials/marketplace/search") %>
    <div class="flex mb-6 justify-between items-center">
        <p class="text-[#a1a1a1] text-sm leading-5">Showing <span class="font-semibold text-neutral-50"><%= projects.length %></span> results</p>
        <div class="flex items-center gap-2">
            <span class="text-[#a1a1a1] text-sm leading-5">Sort by</span>
            <select onchange="window.location.href=this.value" class="rounded-md bg-neutral-900 text-sm leading-5 border-white/10 border-0 border-solid w-48 h-9 text-neutral-50 px-3 outline-none cursor-pointer">
                <option value="/marketplace?sort=popular" <%= sort === 'popular' ? 'selected' : '' %>>Popular</option>
                <option value="/marketplace?sort=newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
                <option value="/marketplace?sort=low" <%= sort === 'low' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="/marketplace?sort=high" <%= sort === 'high' ? 'selected' : '' %>>Price: High to Low</option>
            </select>
        </div>
    </div>
    <div class="flex gap-6">
        <aside class="shrink-0 w-64">
            <%- include("partials/marketplace/filters") %>
        </aside>
        <section class="min-w-0 flex-1">
            <%- include("partials/marketplace/projectGrid") %>
            <%- include("partials/marketplace/pagination") %>
        </section>
    </div>
</main>

<%- include("partials/footer") %>
