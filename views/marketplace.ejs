<%- include("partials/header") %>

<main class="min-h-screen bg-slate-950">
  <form action="/marketplace" method="GET" class="flex gap-4 flex-wrap">

    <!-- Search -->
    <input
        type="text"
        name="search"
        value="<%= search || '' %>"
        placeholder="Search Projects..."
        class="flex-1 px-5 py-3 rounded-xl bg-slate-900 border border-slate-700">

    <!-- Category -->
    <select
        name="category"
        class="px-5 py-3 rounded-xl bg-slate-900 border border-slate-700">

        <option value="">All Categories</option>

        <option value="Web Development"
            <%= category==="Web Development"?"selected":"" %>>
            Web Development
        </option>

        <option value="AI"
            <%= category==="AI"?"selected":"" %>>
            AI
        </option>

        <option value="Mobile Apps"
            <%= category==="Mobile Apps"?"selected":"" %>>
            Mobile Apps
        </option>

        <option value="Desktop Apps"
            <%= category==="Desktop Apps"?"selected":"" %>>
            Desktop Apps
        </option>

    </select>

    <button
        class="px-6 py-3 bg-blue-600 rounded-xl">

        Search

    </button>

    <input
    type="number"
    name="min"
    value="<%= min || '' %>"
    placeholder="Min ₹"
    class="px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 w-32">

<input
    type="number"
    name="max"
    value="<%= max || '' %>"
    placeholder="Max ₹"
    class="px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 w-32">
    

</form>
<form
    action="/marketplace"
    method="GET"
    class="mb-8 flex gap-4">

    <input
        type="text"
        name="search"
        value="<%= search || '' %>"
        placeholder="Search projects..."
        class="flex-1 px-5 py-3 rounded-xl bg-slate-900 border border-slate-700">

    <button
        type="submit"
        class="px-6 py-3 bg-blue-600 rounded-xl">

        Search

    </button>

</form>

    <!-- Search -->
    <%- include("partials/marketplace/search") %>

    <!-- Filters -->
    <%- include("partials/marketplace/filters") %>

    <!-- Project Grid -->
    <%- include("partials/marketplace/projectGrid") %>

    <!-- Pagination -->
  <%- include("partials/marketplace/pagination") %>

</main>

<%- include("partials/footer") %>