<%- include("partials/header") %>

<%
const totalProjects = projects.length;
const publishedCount = projects.filter(p => p.published).length;
const totalValue = projects.reduce((s, p) => s + (p.price || 0), 0);
const categories = [...new Set(projects.map(p => p.category).filter(Boolean))].length;
%>

<main class="max-w-7xl mx-auto pt-28 pb-16 px-6">

    <!-- Welcome Banner -->

    <div
        class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-blue-600/20 to-cyan-500/20 border border-blue-500/20 p-8 md:p-10 mb-10">

        <div
            class="absolute -top-24 -right-24 h-64 w-64 rounded-full bg-blue-600/30 blur-3xl">

        </div>

        <div
            class="absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-cyan-500/20 blur-3xl">

        </div>

        <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-8">

            <div>

                <span
                    class="inline-block px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 text-xs font-semibold uppercase tracking-wider">

                    Seller Dashboard

                </span>

                <h1 class="text-4xl md:text-5xl font-bold mt-4">

                    Welcome back,

                    <span
                        class="bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">

                        <%= user.fullname || user.username %>

                    </span>

                </h1>

                <p class="text-slate-400 mt-4 text-lg">

                    Manage your projects, track listings and grow your developer storefront.

                </p>

            </div>

            <a href="/upload"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:scale-105 transition shadow-lg shadow-blue-600/30 font-semibold whitespace-nowrap">

                <span class="text-2xl leading-none">+</span>

                Upload Project

            </a>

        </div>

    </div>

    <!-- Stats Grid -->

    <div class="grid grid-cols-2 xl:grid-cols-4 gap-6 mb-10">

        <!-- Total Projects -->

        <div
            class="rounded-3xl bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-6 hover:border-blue-500 hover:-translate-y-2 transition duration-300">

            <h3 class="text-slate-400 text-sm">

                Total Projects

            </h3>

            <p class="text-4xl font-bold mt-1">

                <%= totalProjects %>

            </p>

        </div>

        <!-- Published -->

        <div
            class="rounded-3xl bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-6 hover:border-green-500 hover:-translate-y-2 transition duration-300">

            <h3 class="text-slate-400 text-sm">

                Published

            </h3>

            <p class="text-4xl font-bold mt-1">

                <%= publishedCount %>

            </p>

        </div>

        <!-- Total Value -->

        <div
            class="rounded-3xl bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-6 hover:border-cyan-500 hover:-translate-y-2 transition duration-300">

            <h3 class="text-slate-400 text-sm">

                Portfolio Value

            </h3>

            <p class="text-3xl md:text-4xl font-bold mt-1 text-cyan-300">

                ₹<%= totalValue.toLocaleString('en-IN') %>

            </p>

        </div>

        <!-- Categories -->

        <div
            class="rounded-3xl bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-6 hover:border-purple-500 hover:-translate-y-2 transition duration-300">

            <h3 class="text-slate-400 text-sm">

                Categories

            </h3>

            <p class="text-4xl font-bold mt-1">

                <%= categories %>

            </p>

        </div>

    </div>

    <!-- Projects Section -->

    <div class="flex flex-col md:flex-row justify-between md:items-center gap-4 mb-8">

        <div>

            <h2 class="text-3xl font-bold">

                My Projects

            </h2>

            <p class="text-slate-400 mt-2">

                Manage the projects you've listed on RepoX.

            </p>

        </div>

        <a href="/upload"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 hover:border-blue-500 border border-slate-700 transition font-semibold">

            <span class="text-xl leading-none">+</span>

            New Project

        </a>

    </div>

    <% if(projects.length){ %>

        <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8">

            <% projects.forEach(project=>{ %>

                <div
                    class="group rounded-3xl overflow-hidden border border-slate-800 bg-slate-900/60 backdrop-blur-xl hover:border-blue-500 hover:-translate-y-2 transition duration-300 flex flex-col">

                    <!-- Thumbnail -->

                    <div class="relative overflow-hidden h-40">

                        <% if(mediaUrl(project.thumbnail)){ %>

                            <img
                                src="<%= mediaUrl(project.thumbnail) %>"
                                alt="<%= project.title %>"
                                class="w-full h-full object-cover group-hover:scale-105 transition duration-500">

                        <% } else { %>

                            <div
                                class="w-full h-full bg-gradient-to-br from-blue-600/40 to-cyan-500/40">

                            </div>

                        <% } %>

                        <div class="absolute top-4 left-4 flex gap-2">

                            <span
                                class="px-3 py-1 rounded-full bg-blue-600 text-white text-xs font-semibold">

                                <%= project.category || "Project" %>

                            </span>

                        </div>

                        <span
                            class="absolute top-4 right-4 px-3 py-1 rounded-full text-xs font-semibold <%= project.published ? 'bg-green-500/20 text-green-400' : 'bg-amber-500/20 text-amber-400' %>">

                            <%= project.published ? "Published" : "Draft" %>

                        </span>

                    </div>

                    <!-- Content -->

                    <div class="p-6 flex flex-col flex-1">

                        <h3 class="text-2xl font-bold group-hover:text-blue-400 transition">

                            <%= project.title %>

                        </h3>

                        <p class="text-slate-400 text-sm mt-3 line-clamp-2 flex-1">

                            <%= project.shortDescription || project.description || "No description yet." %>

                        </p>

                        <!-- Tech Stack -->

                        <% if(project.techStack && project.techStack.length){ %>

                            <div class="flex flex-wrap gap-2 mt-4">

                                <% project.techStack.slice(0,3).forEach(tech => { %>

                                    <span
                                        class="px-3 py-1 rounded-full bg-slate-800 text-slate-300 text-xs">

                                        <%= tech %>

                                    </span>

                                <% }) %>

                                <% if(project.techStack.length > 3){ %>

                                    <span
                                        class="px-3 py-1 rounded-full bg-slate-800 text-slate-500 text-xs">

                                        +<%= project.techStack.length - 3 %> more

                                    </span>

                                <% } %>

                            </div>

                        <% } %>

                        <!-- Price + Date -->

                        <div class="flex justify-between items-center mt-6 pt-5 border-t border-slate-800">

                            <p class="text-3xl font-bold text-green-400">

                                <%= project.price > 0 ? "₹" + project.price.toLocaleString('en-IN') : "Free" %>

                            </p>

                            <p class="text-xs text-slate-500">

                                Added <%= new Date(project.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>

                            </p>

                        </div>

                        <!-- Actions -->

                        <div class="grid grid-cols-3 gap-3 mt-6">

                            <a href="/projects/<%= project._id %>"
                                class="text-center py-3 rounded-xl bg-slate-800 hover:bg-slate-700 transition font-semibold">

                                View

                            </a>

                            <a href="/projects/<%= project._id %>/edit"
                                class="text-center py-3 rounded-xl bg-blue-600 hover:bg-blue-700 transition font-semibold">

                                Edit

                            </a>

                            <form
                                action="/projects/<%= project._id %>/delete"
                                method="POST"
                                onsubmit="return confirm('Delete this project?')"
                                class="grid">

                                <button
                                    class="w-full py-3 rounded-xl bg-red-600/90 hover:bg-red-600 transition font-semibold">

                                    Delete

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } else { %>

        <!-- Empty State -->

        <div
            class="rounded-3xl border-2 border-dashed border-slate-700 flex flex-col justify-center items-center text-center p-12 md:p-16 hover:border-blue-500 transition">

            <h3 class="text-2xl font-bold mt-6">

                No projects yet

            </h3>

            <p class="text-slate-400 mt-3 max-w-md">

                You haven't uploaded any projects. Start selling your next software project on RepoX.

            </p>

            <a href="/upload"
                class="mt-8 px-8 py-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:scale-105 transition shadow-lg shadow-blue-600/30 font-semibold">

                Upload Your First Project

            </a>

        </div>

    <% } %>

</main>

<%- include("partials/footer") %>
