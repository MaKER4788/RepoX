<% pageTitle = 'Dashboard'; pageDescription = 'Manage your RepoX projects.'; %><%- include("partials/header") %>

<%
const totalProjects = projects.length;
const publishedCount = projects.filter(p => p.published).length;
const totalValue = projects.reduce((s, p) => s + (p.price || 0), 0);
const categories = [...new Set(projects.map(p => p.category).filter(Boolean))].length;
%>

<main class="max-w-7xl mx-auto pt-24 pb-16 px-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
            <h1 class="text-2xl font-bold">Dashboard</h1>
            <p class="text-[#a1a1a1] text-sm mt-1">Manage your projects and listings.</p>
        </div>
        <a href="/upload" class="bg-[oklch(0.55_0.19_255)] font-medium rounded-lg text-white text-sm px-5 py-2.5 flex items-center gap-1.5 hover:opacity-90 transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
            Upload Project
        </a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">
        <div class="rounded-lg bg-neutral-900 border-white/10 border border-solid p-4">
            <p class="text-[#a1a1a1] text-xs">Total Projects</p>
            <p class="text-2xl font-bold mt-1"><%= totalProjects %></p>
        </div>
        <div class="rounded-lg bg-neutral-900 border-white/10 border border-solid p-4">
            <p class="text-[#a1a1a1] text-xs">Published</p>
            <p class="text-2xl font-bold mt-1"><%= publishedCount %></p>
        </div>
        <div class="rounded-lg bg-neutral-900 border-white/10 border border-solid p-4">
            <p class="text-[#a1a1a1] text-xs">Portfolio Value</p>
            <p class="text-2xl font-bold mt-1">₹<%= totalValue.toLocaleString('en-IN') %></p>
        </div>
        <div class="rounded-lg bg-neutral-900 border-white/10 border border-solid p-4">
            <p class="text-[#a1a1a1] text-xs">Categories</p>
            <p class="text-2xl font-bold mt-1"><%= categories %></p>
        </div>
    </div>

    <h2 class="text-lg font-semibold mb-4">My Projects</h2>

    <% if(projects.length){ %>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% projects.forEach(function(project){ %>
        <div class="rounded-xl bg-neutral-900 border-white/10 border border-solid overflow-hidden">
            <div class="relative aspect-video bg-neutral-800 overflow-hidden">
                <% if(project.thumbnail){ %>
                <img src="<%= mediaUrl(project.thumbnail) %>" alt="<%= project.title %>" class="w-full h-full object-cover">
                <% } %>
                <span class="absolute top-2 right-2 px-2 py-0.5 rounded-md text-[10px] font-medium <%= project.published ? 'bg-green-500/20 text-green-400' : 'bg-amber-500/20 text-amber-400' %>"><%= project.published ? 'Published' : 'Draft' %></span>
            </div>
            <div class="p-4">
                <h3 class="font-semibold text-sm"><%= project.title %></h3>
                <p class="text-[#a1a1a1] text-xs mt-1 line-clamp-2"><%= project.shortDescription || project.description || 'No description.' %></p>
                <div class="flex justify-between items-center mt-3 pt-3 border-t border-white/10">
                    <span class="font-semibold text-sm"><%= project.price > 0 ? "₹" + project.price : "Free" %></span>
                    <span class="text-[#a1a1a1] text-[10px]"><%= new Date(project.createdAt).toLocaleDateString() %></span>
                </div>
                <div class="grid grid-cols-3 gap-2 mt-3">
                    <a href="/projects/<%= project._id %>" class="text-center py-2 rounded-lg bg-neutral-800 text-xs hover:bg-neutral-700 transition">View</a>
                    <a href="/projects/<%= project._id %>/edit" class="text-center py-2 rounded-lg bg-[oklch(0.55_0.19_255)]/20 text-[oklch(0.65_0.16_255)] text-xs hover:bg-[oklch(0.55_0.19_255)]/30 transition">Edit</a>
                    <form action="/projects/<%= project._id %>/delete" method="POST" onsubmit="return confirm('Delete this project?')">
                        <button class="w-full py-2 rounded-lg bg-red-500/10 text-red-400 text-xs hover:bg-red-500/20 transition">Delete</button>
                    </form>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
    <% } else { %>
    <div class="rounded-xl border-white/10 border border-solid bg-neutral-900 p-12 text-center">
        <h3 class="text-lg font-semibold">No projects yet</h3>
        <p class="text-[#a1a1a1] text-sm mt-2">Upload your first project to get started.</p>
        <a href="/upload" class="inline-block mt-4 bg-[oklch(0.55_0.19_255)] font-medium rounded-lg text-white text-sm px-5 py-2.5 hover:opacity-90 transition">Upload Project</a>
    </div>
    <% } %>
</main>

<%- include("partials/footer") %>
