<%- include("partials/header") %>

<main class="max-w-7xl mx-auto py-10">

<h1 class="text-4xl font-bold mb-8">

My Projects

</h1>

<% projects.forEach(project=>{ %>

<div class="border rounded-xl p-6 mb-4">

<h2><%= project.title %></h2>

<p><%= project.category %></p>

<p>₹ <%= project.price %></p>

</div>

<% }) %>

</main>

<%- include("partials/footer") %>