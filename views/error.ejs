<% pageTitle = 'Error'; pageDescription = 'Something went wrong on RepoX.'; %><%- include("partials/header") %>

<section class="min-h-screen bg-[#0B0D10] pt-24 pb-16 px-6">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-2xl font-bold mb-6">Error</h1>
        <div class="rounded-xl border-white/10 border border-solid bg-neutral-900 p-6">
            <p class="text-red-400 text-sm font-medium"><%= error.status %></p>
            <p class="text-[#a1a1a1] text-sm mt-2"><%= message %></p>
            <% if(error.stack){ %>
            <pre class="mt-4 text-xs text-[#a1a1a1] bg-neutral-800 rounded-lg p-4 overflow-x-auto"><%= error.stack %></pre>
            <% } %>
        </div>
        <a href="/" class="inline-block mt-4 text-sm text-[oklch(0.65_0.16_255)] hover:opacity-80 transition">← Back to Home</a>
    </div>
</section>

<%- include("partials/footer") %>
