<div class="lg:col-span-2">

    <!-- Welcome Banner -->

    <div
        class="rounded-3xl bg-gradient-to-r from-blue-600/20 to-cyan-500/20 border border-blue-500/20 p-8 mb-8">

        <h1 class="text-4xl font-bold">

            Welcome back,
            <span
                class="bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">

                <%= user.fullname %>

            </span>

            👋

        </h1>

        <p class="text-slate-400 mt-4 text-lg">

            Manage your projects, monitor sales and grow your developer profile.

        </p>

    </div>



    <!-- Stats Grid -->

    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-6">

        <!-- Total Projects -->

        <div
            class="group rounded-3xl bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-6 hover:border-blue-500 hover:-translate-y-2 transition duration-300">

            <div
                class="h-16 w-16 rounded-2xl bg-blue-600/20 flex items-center justify-center text-3xl">

                📂

            </div>

            <h3 class="mt-6 text-slate-400">

                Total Projects

            </h3>

            <h1 class="text-5xl font-bold mt-2">

                12

            </h1>

        </div>



        <!-- Total Sales -->

        <div
            class="group rounded-3xl bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-6 hover:border-green-500 hover:-translate-y-2 transition duration-300">

            <div
                class="h-16 w-16 rounded-2xl bg-green-600/20 flex items-center justify-center text-3xl">

                💰

            </div>

            <h3 class="mt-6 text-slate-400">

                Total Sales

            </h3>

            <h1 class="text-5xl font-bold mt-2">

                ₹25K

            </h1>

        </div>



        <!-- Orders -->

        <div
            class="group rounded-3xl bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-6 hover:border-purple-500 hover:-translate-y-2 transition duration-300">

            <div
                class="h-16 w-16 rounded-2xl bg-purple-600/20 flex items-center justify-center text-3xl">

                🛒

            </div>

            <h3 class="mt-6 text-slate-400">

                Orders

            </h3>

            <h1 class="text-5xl font-bold mt-2">

                154

            </h1>

        </div>



        <!-- Rating -->

        <div
            class="group rounded-3xl bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-6 hover:border-yellow-500 hover:-translate-y-2 transition duration-300">

            <div
                class="h-16 w-16 rounded-2xl bg-yellow-600/20 flex items-center justify-center text-3xl">

                ⭐

            </div>

            <h3 class="mt-6 text-slate-400">

                Rating

            </h3>

            <h1 class="text-5xl font-bold mt-2">

                4.9

            </h1>

        </div>

    </div>



    <!-- Analytics -->

    <div
        class="mt-8 rounded-3xl bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-8">

        <div class="flex justify-between items-center">

            <div>

                <h2 class="text-2xl font-bold">

                    Performance Overview

                </h2>

                <p class="text-slate-400 mt-2">

                    Your activity this month

                </p>

            </div>

            <span
                class="px-4 py-2 rounded-full bg-green-500/20 text-green-400">

                +18%

            </span>

        </div>



        <!-- Progress -->

        <div class="mt-8 space-y-8">

            <div>

                <div class="flex justify-between mb-2">

                    <span>

                        Profile Completion

                    </span>

                    <span>

                        85%

                    </span>

                </div>

                <div class="w-full h-3 rounded-full bg-slate-800">

                    <div
                        class="h-3 rounded-full bg-gradient-to-r from-blue-500 to-cyan-500"
                        style="width:85%"></div>

                </div>

            </div>



            <div>

                <div class="flex justify-between mb-2">

                    <span>

                        Sales Target

                    </span>

                    <span>

                        62%

                    </span>

                </div>

                <div class="w-full h-3 rounded-full bg-slate-800">

                    <div
                        class="h-3 rounded-full bg-gradient-to-r from-green-500 to-emerald-500"
                        style="width:62%"></div>

                </div>

            </div>



            <div>

                <div class="flex justify-between mb-2">

                    <span>

                        Customer Satisfaction

                    </span>

                    <span>

                        98%

                    </span>

                </div>

                <div class="w-full h-3 rounded-full bg-slate-800">

                    <div
                        class="h-3 rounded-full bg-gradient-to-r from-yellow-400 to-orange-500"
                        style="width:98%"></div>

                </div>

            </div>

        </div>

    </div>

</div>