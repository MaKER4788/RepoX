<div class="lg:col-span-1">

    <div class="sticky top-28 rounded-3xl bg-slate-900/60 backdrop-blur-xl border border-slate-800 p-8">

        <!-- Avatar -->

        <div class="flex flex-col items-center">

            <div
                class="h-32 w-32 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500 flex items-center justify-center text-5xl font-bold shadow-lg shadow-blue-500/30">

                <%= user.fullname.charAt(0).toUpperCase() %>

            </div>

            <h2 class="mt-6 text-3xl font-bold text-white">

                <%= user.fullname %>

            </h2>

            <p class="text-slate-400 mt-2">

                @<%= user.username %>

            </p>

            <span
                class="mt-5 px-4 py-2 rounded-full bg-green-500/20 text-green-400 text-sm border border-green-500/30">

                ✅ Verified Developer

            </span>

        </div>

        <!-- Divider -->

        <div class="my-8 border-t border-slate-800"></div>

        <!-- Info -->

        <div class="space-y-5">

            <div class="flex justify-between">

                <span class="text-slate-400">
                    📧 Email
                </span>

                <span class="font-medium text-white text-right">
                    <%= user.email %>
                </span>

            </div>

            <div class="flex justify-between">

                <span class="text-slate-400">
                    🎂 Age
                </span>

                <span class="font-medium text-white">
                    <%= user.age %>
                </span>

            </div>

            <div class="flex justify-between">

                <span class="text-slate-400">
                    👤 Username
                </span>

                <span class="font-medium text-white">
                    @<%= user.username %>
                </span>

            </div>

            <div class="flex justify-between">

                <span class="text-slate-400">
                    🗓 Joined
                </span>

                <span class="font-medium text-white">
                    June 2026
                </span>

            </div>

        </div>

        <!-- Developer Score -->

        <div
            class="mt-10 rounded-2xl bg-gradient-to-r from-blue-600/20 to-cyan-500/20 border border-blue-500/20 p-6">

            <h3 class="font-bold text-xl">

                Developer Score

            </h3>

            <div class="mt-4 flex items-center gap-3">

                <span class="text-yellow-400 text-2xl">

                    ⭐⭐⭐⭐⭐

                </span>

                <span class="font-bold">

                    5.0

                </span>

            </div>

            <p class="text-slate-400 mt-3">

                Top 5% Developer

            </p>

        </div>

        <!-- Buttons -->

        <div class="mt-10 space-y-4">

            <a href="/edit-profile"
                class="block w-full text-center py-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:scale-105 transition duration-300 font-semibold shadow-lg shadow-blue-600/30">

                ✏️ Edit Profile

            </a>

            <a href="/upload"
                class="block w-full text-center py-4 rounded-xl border border-slate-700 hover:border-blue-500 hover:bg-slate-800 transition">

                🚀 Upload Project

            </a>

            <a href="/logout"
                class="block w-full text-center py-4 rounded-xl border border-red-600 text-red-400 hover:bg-red-600 hover:text-white transition">

                Logout

            </a>

        </div>

    </div>

</div>