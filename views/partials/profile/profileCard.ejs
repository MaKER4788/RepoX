<div class="lg:col-span-1">
    <div class="sticky top-24 rounded-xl bg-neutral-900 border-white/10 border border-solid p-6">
        <div class="flex flex-col items-center">
            <div class="size-20 rounded-lg bg-[oklch(0.55_0.19_255)] flex items-center justify-center text-2xl font-bold text-white">
                <%= user.fullname.charAt(0).toUpperCase() %>
            </div>
            <h2 class="mt-4 text-lg font-bold"><%= user.fullname %></h2>
            <p class="text-[#a1a1a1] text-sm">@<%= user.username %></p>
        </div>
        <div class="my-5 border-t border-white/10"></div>
        <div class="space-y-3 text-sm">
            <div class="flex justify-between"><span class="text-[#a1a1a1]">Email</span><span class="font-medium text-right"><%= user.email %></span></div>
            <div class="flex justify-between"><span class="text-[#a1a1a1]">Age</span><span class="font-medium"><%= user.age %></span></div>
            <div class="flex justify-between"><span class="text-[#a1a1a1]">Username</span><span class="font-medium">@<%= user.username %></span></div>
        </div>
        <div class="mt-5 space-y-2">
            <a href="/upload" class="block w-full text-center py-2.5 rounded-lg bg-[oklch(0.55_0.19_255)] hover:opacity-90 transition text-sm font-medium">Upload Project</a>
            <a href="/logout" class="block w-full text-center py-2.5 rounded-lg border-white/10 border border-solid hover:border-red-500/50 text-[#a1a1a1] text-sm transition">Logout</a>
        </div>
    </div>
</div>
