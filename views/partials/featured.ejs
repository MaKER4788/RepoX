<% if(featuredProjects && featuredProjects.length){ %>
<section class="py-10 flex flex-col gap-6">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-semibold text-2xl leading-8 tracking-tight">Featured projects</h2>
            <p class="text-[#a1a1a1] text-sm leading-5 mt-1">Hand-picked software worth exploring.</p>
        </div>
        <a href="/marketplace" class="text-neutral-200 gap-2 flex items-center hover:opacity-80 transition text-sm leading-5">
            View all
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <% featuredProjects.forEach(function(project){ %>
        <a href="/projects/<%= project._id %>" class="group min-w-0 transition-colors bg-neutral-900 border border-white/10 border-solid rounded-xl overflow-hidden flex flex-col">
            <div class="relative w-full overflow-hidden" style="aspect-ratio: 16/9; background-color: <%= project.thumbnailColor || 'oklch(0.22 0.08 250)' %>;">
                <% if(project.thumbnail){ %>
                <img src="<%= mediaUrl(project.thumbnail) %>" alt="<%= project.title %>" class="object-cover w-full h-full opacity-80 block">
                <% } else { %>
                <div class="w-full h-full flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-400"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
                </div>
                <% } %>
                <form action="/wishlist/<%= project._id %>" method="POST" class="absolute right-3 top-3">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="size-9 rounded-lg bg-neutral-950/80 flex justify-center items-center hover:bg-neutral-950 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                    </button>
                </form>
            </div>
            <div class="flex p-4 flex-col gap-3 flex-1 min-w-0">
                <div class="min-w-0">
                    <h3 class="font-medium text-sm leading-5 truncate"><%= project.title %></h3>
                    <p class="text-[#a1a1a1] text-xs leading-5 mt-1 line-clamp-2"><%= project.shortDescription || '' %></p>
                </div>
                <div class="flex gap-1.5 flex-wrap">
                    <% if(project.techStack && project.techStack.length){ %>
                    <% project.techStack.slice(0,2).forEach(function(tech){ %>
                    <span class="text-[10px] rounded-md bg-neutral-800 px-2 py-0.5"><%= tech %></span>
                    <% }) %>
                    <% } %>
                </div>
                <div class="text-sm leading-5 border-white/10 border-t border-solid flex pt-3 mt-auto justify-between items-center min-w-0">
                    <span class="text-[#a1a1a1] text-xs truncate">by <%= project.owner ? project.owner.username : 'Unknown' %></span>
                    <span class="font-semibold text-sm shrink-0">₹<%= project.price %></span>
                </div>
            </div>
        </a>
        <% }) %>
    </div>
</section>
<% } %>