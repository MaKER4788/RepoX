<section class="rounded-xl border-white/10 border border-solid bg-neutral-900 p-6 space-y-8">
    <% if(project.features){ %>
    <div>
        <h2 class="text-base font-semibold mb-3">Features</h2>
        <p class="text-[#a1a1a1] text-sm leading-7 whitespace-pre-line"><%= project.features %></p>
    </div>
    <% } %>
    <% if(project.included){ %>
    <div>
        <h2 class="text-base font-semibold mb-3">What's Included</h2>
        <p class="text-[#a1a1a1] text-sm leading-7 whitespace-pre-line"><%= project.included %></p>
    </div>
    <% } %>
    <% if(project.requirements){ %>
    <div>
        <h2 class="text-base font-semibold mb-3">Requirements</h2>
        <p class="text-[#a1a1a1] text-sm leading-7 whitespace-pre-line"><%= project.requirements %></p>
    </div>
    <% } %>
    <% if(project.installation){ %>
    <div>
        <h2 class="text-base font-semibold mb-3">Installation</h2>
        <p class="text-[#a1a1a1] text-sm leading-7 whitespace-pre-line"><%= project.installation %></p>
    </div>
    <% } %>
    <% if(project.changelog){ %>
    <div>
        <h2 class="text-base font-semibold mb-3">Changelog</h2>
        <p class="text-[#a1a1a1] text-sm leading-7 whitespace-pre-line"><%= project.changelog %></p>
    </div>
    <% } %>
</section>
