<section class="rounded-xl border-white/10 border border-solid bg-neutral-900 overflow-hidden">
    <img src="<%= mediaUrl(project.thumbnail) %>" alt="<%= project.title %>" class="w-full h-56 sm:h-80 md:h-[400px] object-cover">
</section>
<% if(project.screenshots && project.screenshots.length){ %>
<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-4">
    <% project.screenshots.forEach(function(image){ %>
    <div class="rounded-lg overflow-hidden border-white/10 border border-solid hover:border-white/20 transition">
        <img src="<%= mediaUrl(image) %>" class="w-full h-28 object-cover hover:scale-105 transition duration-300 cursor-pointer">
    </div>
    <% }) %>
</div>
<% } %>
