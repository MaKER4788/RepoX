<section>

    <!-- Main Thumbnail -->

    <div
        class="rounded-3xl overflow-hidden border border-slate-800 bg-slate-900">

        <img
            src="<%= mediaUrl(project.thumbnail) %>"
            alt="<%= project.title %>"
            class="w-full h-[500px] object-cover">

    </div>

    <!-- Screenshots -->

    <% if(project.screenshots && project.screenshots.length){ %>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">

            <% project.screenshots.forEach(function(image){ %>

                <div
                    class="rounded-2xl overflow-hidden border border-slate-800 hover:border-blue-500 transition">

                    <img
                        src="<%= mediaUrl(image) %>"
                        class="w-full h-36 object-cover hover:scale-110 transition duration-300 cursor-pointer">

                </div>

            <% }) %>

        </div>

    <% } %>

</section>