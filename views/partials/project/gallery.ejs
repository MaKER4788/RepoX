<div class="rounded-xl bg-neutral-900 border-white/10 border border-solid mb-4 overflow-hidden">
    <img src="<%= mediaUrl(project.thumbnail) %>" alt="<%= project.title %>" class="object-cover w-full h-90" id="mainImage">
</div>
<% if(project.screenshots && project.screenshots.length){ %>
<div class="flex mb-8 gap-3">
    <button onclick="changeImage('<%= mediaUrl(project.thumbnail) %>')" class="rounded-lg border-black/10 border border-solid w-24 h-16 overflow-hidden">
        <img src="<%= mediaUrl(project.thumbnail) %>" alt="Thumbnail" class="object-cover w-full h-full">
    </button>
    <% project.screenshots.forEach(function(image){ %>
    <button onclick="changeImage('<%= mediaUrl(image) %>')" class="rounded-lg border-black/10 border border-solid w-24 h-16 overflow-hidden">
        <img src="<%= mediaUrl(image) %>" alt="Thumbnail" class="object-cover w-full h-full">
    </button>
    <% }) %>
</div>
<% } %>
<script>
function changeImage(src) {
    document.getElementById('mainImage').src = src;
}
</script>