<section class="mt-16">

    <h2 class="text-3xl font-bold text-white mb-8">
        ⭐ Reviews
    </h2>

    <% if(user){ %>

    <form
        action="/reviews/<%= project._id %>"
        method="POST"
        class="space-y-6 mb-12">

        <div>

            <label class="text-slate-300 block mb-2">
                Rating
            </label>

            <select
                name="rating"
                required
                class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700">

                <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                <option value="4">⭐⭐⭐⭐ (4)</option>
                <option value="3">⭐⭐⭐ (3)</option>
                <option value="2">⭐⭐ (2)</option>
                <option value="1">⭐ (1)</option>

            </select>

        </div>

        <div>

            <label class="text-slate-300 block mb-2">
                Comment
            </label>

            <textarea
                name="comment"
                rows="5"
                required
                placeholder="Write your review..."
                class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700"></textarea>

        </div>

        <button
            class="px-8 py-3 rounded-xl bg-blue-600 hover:bg-blue-700">

            Submit Review

        </button>

    </form>
    <% if(project.reviews.length){ %>
        <div class="mb-8">

    <% 
        let average = 0;

        if(project.reviews.length){
            average = project.reviews.reduce((sum, review) =>
                sum + review.rating, 0
            ) / project.reviews.length;
        }
    %>

    <h2 class="text-3xl font-bold text-white">

        ⭐ Reviews

    </h2>

    <p class="text-slate-400 mt-2">

        <span class="text-yellow-400 font-semibold">
            <%= average.toFixed(1) %> / 5
        </span>

        •

        <%= project.reviews.length %> Reviews

    </p>

</div>

<div class="space-y-6">

    <% project.reviews.forEach(review => { %>

    <div class="rounded-2xl bg-slate-900 border border-slate-800 p-6">

        <div class="flex justify-between items-center">

            <div>

                <h3 class="text-white font-semibold">

                    <%= review.user.fullname %>

                </h3>

                <p class="text-slate-500 text-sm">

                    <%= new Date(review.createdAt).toLocaleDateString() %>

                </p>

            </div>

            <div class="text-yellow-400 text-xl">

                <% for(let i=1;i<=5;i++){ %>

                    <% if(i<=review.rating){ %>

                        ★

                    <% }else{ %>

                        ☆

                    <% } %>

                <% } %>

            </div>

        </div>

        <p class="text-slate-300 mt-5 leading-7">

            <%= review.comment %>

        </p>

    </div>

    <% }) %>

</div>

<% } %>

    <% } %>

<% if(!project.reviews.length){ %>

<div class="rounded-2xl bg-slate-900 border border-slate-800 p-10 text-center">

    <h3 class="text-2xl font-semibold text-white">

        No Reviews Yet

    </h3>

    <p class="text-slate-400 mt-3">

        Be the first person to review this project.

    </p>

</div>

<% } %>