<div class="rounded-xl border-white/10 border border-solid bg-neutral-900 p-6 mt-4">
    <h2 class="text-sm font-semibold mb-4">Seller</h2>
    <div class="flex items-center gap-3">
        <div class="size-10 rounded-lg bg-[oklch(0.55_0.19_255)] flex items-center justify-center text-sm font-bold text-white">
            <%= project.owner.username.charAt(0).toUpperCase() %>
        </div>
        <div>
            <h3 class="text-sm font-semibold"><%= project.owner.username %></h3>
            <p class="text-[#a1a1a1] text-xs">Developer</p>
        </div>
    </div>
    <div class="mt-4 space-y-2">
        <a href="/users/<%= project.owner._id %>" class="block w-full text-center py-2.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 transition text-sm font-medium">View Profile</a>
    </div>
</div>
