<section class="rounded-3xl border border-slate-800 bg-slate-900 p-8">

    <!-- Title -->

    <h1 class="text-4xl font-bold text-white">

        <%= project.title %>

    </h1>

    <!-- Short Description -->

    <% if(project.shortDescription){ %>

        <p class="text-slate-400 mt-4 text-lg leading-8">

            <%= project.shortDescription %>

        </p>

    <% } %>

    <!-- Stats -->

    <div class="flex flex-wrap gap-6 mt-8 text-sm text-slate-400">

        <span>
            📂 <strong class="text-white">Category:</strong>
            <%= project.category %>
        </span>

        <span>
            📦 <strong class="text-white">Version:</strong>
            <%= project.version || "1.0.0" %>
        </span>

        <span>
            📅 <strong class="text-white">Updated:</strong>
            <%= project.lastUpdated ? new Date(project.lastUpdated).toLocaleDateString() : "N/A" %>
        </span>

    </div>

    <!-- Description -->

    <div class="mt-10">

        <h2 class="text-2xl font-semibold text-white mb-4">

            About this Project

        </h2>

        <p class="text-slate-300 leading-8 whitespace-pre-line">

            <%= project.description %>

        </p>

    </div>

    <!-- Tech Stack -->

    <% if(project.techStack && project.techStack.length){ %>

        <div class="mt-10">

            <h2 class="text-2xl font-semibold text-white mb-4">

                Tech Stack

            </h2>

            <div class="flex flex-wrap gap-3">

                <% project.techStack.forEach(function(tech){ %>

                    <span
                        class="px-4 py-2 rounded-full bg-slate-800 border border-slate-700 text-slate-300">

                        <%= tech %>

                    </span>

                <% }) %>

            </div>

        </div>

    <% } %>

    <!-- Tags -->

    <% if(project.tags && project.tags.length){ %>

        <div class="mt-10">

            <h2 class="text-2xl font-semibold text-white mb-4">

                Tags

            </h2>

            <div class="flex flex-wrap gap-3">

                <% project.tags.forEach(function(tag){ %>

                    <span
                        class="px-4 py-2 rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300">

                        #<%= tag %>

                    </span>

                <% }) %>

            </div>

        </div>

    <% } %>

    <!-- Links -->

    <div class="flex flex-wrap gap-4 mt-10">

        <% if(project.github){ %>

            <a
                href="<%= project.github %>"
                target="_blank"
                class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 transition">

                GitHub

            </a>

        <% } %>

        <% if(project.liveDemo){ %>

            <a
                href="<%= project.liveDemo %>"
                target="_blank"
                class="px-6 py-3 rounded-xl bg-green-600 hover:bg-green-700 transition">

                Live Demo

            </a>

        <% } %>

    </div>

</section>