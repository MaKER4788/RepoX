<section class="rounded-xl border-white/10 border border-solid bg-neutral-900 p-6">
    <h1 class="text-2xl font-bold"><%= project.title %></h1>
    <% if(project.shortDescription){ %>
    <p class="text-[#a1a1a1] text-sm mt-3 leading-6"><%= project.shortDescription %></p>
    <% } %>
    <div class="flex flex-wrap gap-4 mt-4 text-xs text-[#a1a1a1]">
        <span><strong class="text-neutral-50">Category:</strong> <%= project.category %></span>
        <span><strong class="text-neutral-50">Version:</strong> <%= project.version || "1.0.0" %></span>
        <span><strong class="text-neutral-50">Updated:</strong> <%= project.lastUpdated ? new Date(project.lastUpdated).toLocaleDateString() : "N/A" %></span>
    </div>
    <div class="mt-6">
        <h2 class="text-base font-semibold mb-3">About this Project</h2>
        <p class="text-[#a1a1a1] text-sm leading-7 whitespace-pre-line"><%= project.description %></p>
    </div>
    <% if(project.techStack && project.techStack.length){ %>
    <div class="mt-6">
        <h2 class="text-base font-semibold mb-3">Tech Stack</h2>
        <div class="flex flex-wrap gap-2">
            <% project.techStack.forEach(function(tech){ %>
            <span class="px-3 py-1 rounded-lg bg-neutral-800 border-white/10 border border-solid text-[#a1a1a1] text-xs"><%= tech %></span>
            <% }) %>
        </div>
    </div>
    <% } %>
    <% if(project.tags && project.tags.length){ %>
    <div class="mt-6">
        <h2 class="text-base font-semibold mb-3">Tags</h2>
        <div class="flex flex-wrap gap-2">
            <% project.tags.forEach(function(tag){ %>
            <span class="px-3 py-1 rounded-lg bg-[oklch(0.55_0.19_255)]/10 border border-solid text-[oklch(0.65_0.16_255)] text-xs">#<%= tag %></span>
            <% }) %>
        </div>
    </div>
    <% } %>
    <div class="flex flex-wrap gap-3 mt-6">
        <% if(project.github){ %>
        <a href="<%= project.github %>" target="_blank" class="px-4 py-2 rounded-lg bg-neutral-800 hover:bg-neutral-700 transition text-sm">GitHub</a>
        <% } %>
        <% if(project.liveDemo){ %>
        <a href="<%= project.liveDemo %>" target="_blank" class="px-4 py-2 rounded-lg bg-[oklch(0.55_0.19_255)] hover:opacity-90 transition text-sm text-white">Live Demo</a>
        <% } %>
    </div>
</section>
