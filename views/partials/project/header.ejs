<div class="mb-6">
    <h1 class="font-semibold text-3xl leading-9 tracking-tight mb-2"><%= project.title %></h1>
    <% if(project.shortDescription){ %>
    <p class="max-w-2xl text-[#a1a1a1] text-sm leading-5 mb-4"><%= project.shortDescription %></p>
    <% } %>
    <% if(project.techStack && project.techStack.length){ %>
    <div class="flex mb-4 flex-wrap items-center gap-2">
        <% project.techStack.forEach(function(tech){ %>
        <span class="font-mono rounded-md bg-neutral-800 text-xs leading-4 border-white/10 border border-solid px-2.5 py-1"><%= tech %></span>
        <% }) %>
    </div>
    <% } %>
    <div class="text-[#a1a1a1] text-sm leading-5 flex items-center gap-3">
        <div class="size-6 rounded-full bg-[oklch(0.55_0.16_252)] flex items-center justify-center text-[10px] font-bold text-white">
            <%= project.owner.username.charAt(0).toUpperCase() %>
        </div>
        <span>by <span class="text-neutral-50"><%= project.owner.username %></span></span>
        <span class="text-white/10">|</span>
        <span>Published <%= new Date(project.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
    </div>
</div>