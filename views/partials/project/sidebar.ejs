<div class="sticky top-8 space-y-4">
    <div class="rounded-xl border-white/10 border border-solid bg-neutral-900 p-6">
        <div class="flex items-center justify-between">
            <span class="text-[#a1a1a1] text-sm">Price</span>
            <span class="text-2xl font-bold">₹<%= project.price %></span>
        </div>
        <% if(project.discount > 0){ %>
        <span class="inline-block mt-3 px-2 py-0.5 rounded-md bg-red-500/10 text-red-400 text-xs"><%= project.discount %>% OFF</span>
        <% } %>
        <div class="mt-5 space-y-3">
            <button class="w-full py-3 rounded-lg bg-[oklch(0.55_0.19_255)] hover:opacity-90 transition font-medium text-sm">Buy Now</button>
            <form action="/wishlist/<%= project._id %>" method="POST">
                <button class="w-full py-3 rounded-lg border-white/10 border border-solid hover:border-white/20 transition text-sm text-[#a1a1a1]">♡ Add to Wishlist</button>
            </form>
        </div>
    </div>
    <div class="rounded-xl border-white/10 border border-solid bg-neutral-900 p-6">
        <h2 class="text-sm font-semibold mb-4">What's Included</h2>
        <div class="space-y-3 text-xs">
            <div class="flex justify-between"><span class="text-[#a1a1a1]">Source Code</span><span>✓</span></div>
            <div class="flex justify-between"><span class="text-[#a1a1a1]">Documentation</span><span>✓</span></div>
            <div class="flex justify-between"><span class="text-[#a1a1a1]">License</span><span><%= project.license || "Single Use" %></span></div>
            <div class="flex justify-between"><span class="text-[#a1a1a1]">Support</span><span><%= project.support || "No Support" %></span></div>
            <div class="flex justify-between"><span class="text-[#a1a1a1]">Version</span><span><%= project.version || "1.0.0" %></span></div>
        </div>
    </div>
</div>
