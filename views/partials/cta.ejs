<section class="py-24 bg-slate-950 relative overflow-hidden">

    <!-- Background Glow -->

    <div class="absolute top-0 left-0 w-96 h-96 bg-blue-600/20 blur-[140px] rounded-full"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-cyan-500/20 blur-[140px] rounded-full"></div>

    <div class="relative max-w-6xl mx-auto px-6">

        <div class="rounded-[32px] border border-slate-800 bg-slate-900/60 backdrop-blur-xl p-10 md:p-16">

            <div class="grid lg:grid-cols-2 gap-12 items-center">

                <!-- Left -->

                <div>

                    <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-sm">

                         Start Your Journey

                    </span>

                    <h2 class="text-4xl md:text-6xl font-extrabold mt-8 leading-tight">

                        Turn Your

                        <span class="bg-gradient-to-r from-blue-500 to-cyan-400 bg-clip-text text-transparent">

                            Code

                        </span>

                        Into Income.

                    </h2>

                    <p class="mt-6 text-slate-400 text-lg leading-8">

                        Upload your software projects, showcase your skills,
                        reach thousands of developers and startups, and earn
                        money from every sale.

                    </p>

                </div>

                <!-- Right -->

                <div class="flex flex-col gap-5">

                    <% if(user){ %>

                        <a href="/upload"
                            class="w-full text-center px-8 py-5 rounded-2xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:scale-105 transition duration-300 shadow-xl shadow-blue-500/30 text-lg font-semibold">

                             Upload Your First Project

                        </a>

                        <a href="/dashboard"
                            class="w-full text-center px-8 py-5 rounded-2xl border border-slate-700 hover:border-blue-500 hover:bg-slate-800 transition text-lg">

                             Go To Dashboard

                        </a>

                    <% } else { %>

                        <a href="/register"
                            class="w-full text-center px-8 py-5 rounded-2xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:scale-105 transition duration-300 shadow-xl shadow-blue-500/30 text-lg font-semibold">

                             Create Free Account

                        </a>

                        <a href="/login"
                            class="w-full text-center px-8 py-5 rounded-2xl border border-slate-700 hover:border-blue-500 hover:bg-slate-800 transition text-lg">

                             Login

                        </a>

                    <% } %>

                </div>

            </div>

            <!-- Bottom Stats -->

            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-16 border-t border-slate-800 pt-10">

                <div class="text-center">

                    <h3 class="text-3xl font-bold text-blue-400">
                        500+
                    </h3>

                    <p class="text-slate-500 mt-2">
                        Projects
                    </p>

                </div>

                <div class="text-center">

                    <h3 class="text-3xl font-bold text-cyan-400">
                        5K+
                    </h3>

                    <p class="text-slate-500 mt-2">
                        Developers
                    </p>

                </div>

                <div class="text-center">

                    <h3 class="text-3xl font-bold text-green-400">
                        ₹10L+
                    </h3>

                    <p class="text-slate-500 mt-2">
                        Revenue
                    </p>

                </div>

                <div class="text-center">

                    <h3 class="text-3xl font-bold text-purple-400">
                        99%
                    </h3>

                    <p class="text-slate-500 mt-2">
                        Satisfaction
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>