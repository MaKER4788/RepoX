<% if(newProjects && newProjects.length){ %>
<section class="px-8 pb-8">
    <div class="flex mb-4 justify-between items-center">
        <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="oklch(0.65 0.16 255)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            <h2 class="font-semibold text-lg leading-7 tracking-tight">New Releases</h2>
        </div>
        <a href="/marketplace?sort=newest" class="text-[oklch(0.65_0.16_255)] text-sm leading-5 flex items-center gap-1 hover:opacity-80 transition">
            View all
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% newProjects.forEach(function(project){ %>
        <a href="/projects/<%= project._id %>" class="group transition-colors rounded-xl bg-neutral-900 border-white/10 border border-solid p-0 gap-0 overflow-hidden hover:border-white/20">
            <div class="relative aspect-video bg-neutral-800 overflow-hidden">
                <% if(project.thumbnail){ %>
                <img src="<%= mediaUrl(project.thumbnail) %>" alt="<%= project.title %>" class="object-cover transition-transform duration-300 group-hover:scale-105 w-full h-full">
                <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-neutral-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                </div>
                <% } %>
                <span class="backdrop-blur-sm rounded-md bg-neutral-900/80 text-[#a1a1a1] text-[10px] absolute left-2 top-2 px-2 py-0.5"><%= new Date(project.createdAt).toLocaleDateString('en-US', {month:'short', day:'numeric'}) %></span>
            </div>
            <div class="flex p-4 flex-col gap-2">
                <h3 class="font-semibold text-sm leading-5 line-clamp-1"><%= project.title %></h3>
                <p class="line-clamp-2 text-[#a1a1a1] text-xs leading-4"><%= project.shortDescription || '' %></p>
                <div class="flex flex-wrap gap-1.5">
                    <% if(project.techStack && project.techStack.length){ %>
                    <% project.techStack.slice(0,2).forEach(function(tech){ %>
                    <span class="font-normal rounded-md bg-neutral-800 text-[#a1a1a1] text-[10px] border-white/10 border border-solid px-2 py-0"><%= tech %></span>
                    <% }) %>
                    <% } %>
                </div>
                <div class="border-white/10 border-t border-solid flex mt-1 pt-3 justify-between items-center">
                    <span class="text-[#a1a1a1] text-xs leading-4">by <%= project.owner ? project.owner.username : 'Unknown' %></span>
                    <span class="font-semibold text-sm leading-5">₹<%= project.price %></span>
                </div>
            </div>
        </a>
        <% }) %>
    </div>
</section>
<% } %>
