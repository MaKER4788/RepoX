<section class="border-t border-white/10 pt-6">
    <div class="mb-6">
        <h2 class="text-lg font-semibold">Publish Project</h2>
        <p class="text-[#a1a1a1] text-sm mt-1">Review your submission and publish it to the marketplace.</p>
    </div>
    <div class="rounded-lg border-white/10 border border-solid bg-neutral-800 p-5 space-y-4">
        <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="agreeTerms" required class="mt-0.5 accent-[oklch(0.55_0.19_255)]">
            <span class="text-[#a1a1a1] text-sm leading-6">I confirm that I own this project or have the legal right to sell it. I understand that uploading copyrighted or stolen content may result in permanent account suspension.</span>
        </label>
        <label class="flex items-start gap-3 cursor-pointer">
            <input type="checkbox" name="qualityCheck" required class="mt-0.5 accent-[oklch(0.55_0.19_255)]">
            <span class="text-[#a1a1a1] text-sm leading-6">I have tested this project, removed sensitive API keys, passwords, and personal information before publishing.</span>
        </label>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 mt-6">
        <button type="submit" name="action" value="draft" class="flex-1 py-2.5 rounded-lg border-white/10 border border-solid hover:border-white/20 hover:bg-neutral-800 transition text-sm">Save as Draft</button>
        <button type="submit" name="action" value="publish" class="flex-1 py-2.5 rounded-lg bg-[oklch(0.55_0.19_255)] hover:opacity-90 transition font-medium text-sm text-white">Publish Project</button>
    </div>
</section>
