<!-- ================= Publish Project ================= -->

<section class="border-t border-slate-800 pt-10">

    <div class="mb-8">

        <h2 class="text-3xl font-bold text-white">

             Publish Project

        </h2>

        <p class="text-slate-400 mt-2">

            Review your submission and publish it to the RepoX marketplace.

        </p>

    </div>

    <!-- Seller Agreement -->

    <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 space-y-5">

        <label class="flex items-start gap-4 cursor-pointer">

            <input
                type="checkbox"
                name="agreeTerms"
                required
                class="mt-1 h-5 w-5 accent-blue-500">

            <span class="text-slate-300 leading-7">

                I confirm that I own this project or have the legal right to
                sell it. I understand that uploading copyrighted or stolen
                content may result in permanent account suspension.

            </span>

        </label>

        <label class="flex items-start gap-4 cursor-pointer">

            <input
                type="checkbox"
                name="qualityCheck"
                required
                class="mt-1 h-5 w-5 accent-blue-500">

            <span class="text-slate-300 leading-7">

                I have tested this project, removed sensitive API keys,
                passwords, and personal information before publishing.

            </span>

        </label>

    </div>

    <!-- Security Notice -->

    <div
        class="mt-8 rounded-2xl border border-green-500/20 bg-green-500/10 p-6">

        <h3 class="text-xl font-semibold text-green-400">

             Secure Upload

        </h3>

        <p class="text-slate-300 mt-3 leading-7">

            Every uploaded project is scanned before becoming visible on
            RepoX. This helps keep the marketplace safe for both buyers
            and sellers.

        </p>

    </div>

    <!-- Action Buttons -->

    <div class="flex flex-col md:flex-row gap-4 mt-10">

        <button
            type="submit"
            name="action"
            value="draft"
            class="flex-1 py-4 rounded-xl border border-slate-700 hover:border-blue-500 hover:bg-slate-800 transition">

             Save as Draft

        </button>

        <button
            type="button"
            onclick="window.history.back()"
            class="flex-1 py-4 rounded-xl border border-slate-700 hover:border-cyan-500 hover:bg-slate-800 transition">

             Preview

        </button>

        <button
            type="submit"
            name="action"
            value="publish"
            class="flex-1 py-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 hover:scale-[1.02] transition font-semibold shadow-xl shadow-blue-600/30">

             Publish Project

        </button>

    </div>

</section>