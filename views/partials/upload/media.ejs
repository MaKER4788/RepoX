<!-- ================= Media & Files ================= -->

<section class="border-t border-slate-800 pt-10">

    <div class="mb-8">

        <h2 class="text-3xl font-bold text-white">

             Media & Files

        </h2>

        <p class="text-slate-400 mt-2">

            Upload images and files that showcase your project.

        </p>

    </div>

    <div class="grid md:grid-cols-2 gap-8">

        <!-- Thumbnail -->

        <div>

            <label class="block text-slate-300 mb-3">

                Project Thumbnail

            </label>
            <% if (project?.thumbnail) { %>

<div class="mb-4">
    <img
        src="<%= mediaUrl(project.thumbnail) %>"
        alt="Thumbnail"
        class="w-48 rounded-xl border border-slate-700">
</div>

<% } %>

            <div
                class="border-2 border-dashed border-slate-700 rounded-2xl p-8 text-center hover:border-blue-500 transition">

                
                <p class="text-slate-400 mb-4">

                    Upload a thumbnail image

                </p>

                <input
                    type="file"
                    name="thumbnail"
                    accept="image/*"
                    class="block w-full text-sm text-slate-300
                    file:mr-4
                    file:px-4
                    file:py-2
                    file:border-0
                    file:rounded-lg
                    file:bg-blue-600
                    file:text-white
                    hover:file:bg-blue-500">

            </div>

        </div>

        <!-- Screenshots -->

        <div>

            <label class="block text-slate-300 mb-3">

                Screenshots

            </label>

            <div
                class="border-2 border-dashed border-slate-700 rounded-2xl p-8 text-center hover:border-cyan-500 transition">

                
                <p class="text-slate-400 mb-4">

                    Upload multiple screenshots

                </p>
                <% if (project?.screenshots?.length) { %>

<div class="grid grid-cols-3 gap-3 mb-4">

    <% project.screenshots.forEach(image => { %>

        <img
            src="<%= mediaUrl(image) %>"
            class="rounded-lg border border-slate-700">

    <% }) %>

</div>

<% } %>
                <input
                    type="file"
                    name="screenshots"
                    multiple
                    accept="image/*"
                    class="block w-full text-sm text-slate-300
                    file:mr-4
                    file:px-4
                    file:py-2
                    file:border-0
                    file:rounded-lg
                    file:bg-cyan-600
                    file:text-white
                    hover:file:bg-cyan-500">

            </div>

        </div>

        <!-- ZIP File -->

        <div>

            <label class="block text-slate-300 mb-3">

                Project ZIP

            </label>
            <% if(project?.zipFile){ %>

<p class="text-green-400 mb-3">
    Current File: <%= project.zipFile %>
</p>

<% } %>

            <input
                type="file"
                name="projectZip"
                accept=".zip,.rar,.7z"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 file:mr-4 file:px-4 file:py-2 file:border-0 file:rounded-lg file:bg-green-600 file:text-white hover:file:bg-green-500">

        </div>

        <!-- Documentation -->

        <div>

            <label class="block text-slate-300 mb-3">

                Documentation (Optional)

            </label>
           <% if(project?.documentation){ %>

<p class="text-blue-400 mb-3">
    Current File: <%= project.documentation %>
</p>

<% } %>
            <input
                type="file"
                name="documentation"
                accept=".pdf"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 file:mr-4 file:px-4 file:py-2 file:border-0 file:rounded-lg file:bg-purple-600 file:text-white hover:file:bg-purple-500">

        </div>

        <!-- Demo Video -->

        <div class="md:col-span-2">

            <label class="block text-slate-300 mb-3">

                Demo Video URL

            </label>

            <input
type="url"
name="demoVideo"
value="<%= project?.demoVideo || '' %>"
placeholder="https://youtube.com/..."
class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-red-500 outline-none transition">
        </div>

    </div>

</section>