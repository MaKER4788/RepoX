<section class="border-t border-white/10 pt-6">
    <div class="mb-6">
        <h2 class="text-lg font-semibold">Media & Files</h2>
        <p class="text-[#a1a1a1] text-sm mt-1">Upload images and files that showcase your project.</p>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-2">Project Thumbnail</label>
            <% if (project?.thumbnail) { %>
            <div class="mb-3"><img src="<%= mediaUrl(project.thumbnail) %>" alt="Thumbnail" class="w-40 rounded-lg border-white/10 border border-solid"></div>
            <% } %>
            <div class="border border-dashed border-white/10 rounded-lg p-6 text-center hover:border-white/20 transition">
                <p class="text-[#a1a1a1] text-sm mb-3">Upload a thumbnail image</p>
                <input type="file" name="thumbnail" accept="image/*" class="block w-full text-sm text-[#a1a1a1] file:mr-4 file:px-4 file:py-2 file:border-0 file:rounded-lg file:bg-[oklch(0.55_0.19_255)] file:text-white file:text-sm">
            </div>
        </div>
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-2">Screenshots</label>
            <div class="border border-dashed border-white/10 rounded-lg p-6 text-center hover:border-white/20 transition">
                <p class="text-[#a1a1a1] text-sm mb-3">Upload multiple screenshots</p>
                <% if (project?.screenshots?.length) { %>
                <div class="grid grid-cols-3 gap-2 mb-3">
                    <% project.screenshots.forEach(function(image){ %>
                    <img src="<%= mediaUrl(image) %>" class="rounded-lg border-white/10 border border-solid">
                    <% }) %>
                </div>
                <% } %>
                <input type="file" name="screenshots" multiple accept="image/*" class="block w-full text-sm text-[#a1a1a1] file:mr-4 file:px-4 file:py-2 file:border-0 file:rounded-lg file:bg-[oklch(0.55_0.19_255)] file:text-white file:text-sm">
            </div>
        </div>
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-2">Project ZIP</label>
            <% if(project?.zipFile){ %>
            <p class="text-green-400 text-xs mb-2">Current: <%= project.zipFile %></p>
            <% } %>
            <input type="file" name="projectZip" accept=".zip,.rar,.7z" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm file:mr-4 file:px-4 file:py-2 file:border-0 file:rounded-lg file:bg-green-600 file:text-white file:text-sm">
        </div>
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-2">Documentation (Optional)</label>
            <% if(project?.documentation){ %>
            <p class="text-blue-400 text-xs mb-2">Current: <%= project.documentation %></p>
            <% } %>
            <input type="file" name="documentation" accept=".pdf" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm file:mr-4 file:px-4 file:py-2 file:border-0 file:rounded-lg file:bg-[oklch(0.55_0.19_255)] file:text-white file:text-sm">
        </div>
        <div class="md:col-span-2">
            <label class="block text-[#a1a1a1] text-sm mb-1">Demo Video URL</label>
            <input type="url" name="demoVideo" value="<%= project?.demoVideo || '' %>" placeholder="https://youtube.com/..." class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)] transition">
        </div>
    </div>
</section>
