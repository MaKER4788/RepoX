<section class="border-t border-white/10 pt-6">
    <div class="mb-6">
        <h2 class="text-lg font-semibold">Project Details</h2>
        <p class="text-[#a1a1a1] text-sm mt-1">Explain everything buyers need to know before purchasing.</p>
    </div>
    <div class="space-y-5">
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-1">Detailed Description</label>
            <textarea name="description" rows="6" required placeholder="Write a complete description of your project..." class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)] resize-y"></textarea>
        </div>
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-1">Key Features</label>
            <textarea name="features" rows="4" placeholder="JWT Authentication, Admin Dashboard, Payment Integration..." class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)] resize-y"></textarea>
        </div>
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-1">Installation Guide</label>
            <textarea name="installation" rows="4" placeholder="npm install, Create .env, npm run dev..." class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)] resize-y"></textarea>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
            <div>
                <label class="block text-[#a1a1a1] text-sm mb-1">Requirements</label>
                <textarea name="requirements" rows="3" placeholder="Node.js v22+, MongoDB, Redis..." class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)]"></textarea>
            </div>
            <div>
                <label class="block text-[#a1a1a1] text-sm mb-1">What's Included</label>
                <textarea name="included" rows="3" placeholder="Source Code, Documentation, Database..." class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)]"></textarea>
            </div>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
            <div>
                <label class="block text-[#a1a1a1] text-sm mb-1">Current Version</label>
                <input type="text" name="version" placeholder="v1.0.0" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)]">
            </div>
            <div>
                <label class="block text-[#a1a1a1] text-sm mb-1">Last Updated</label>
                <input type="date" name="lastUpdated" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 outline-none focus:border-[oklch(0.55_0.19_255)]">
            </div>
        </div>
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-1">Changelog</label>
            <textarea name="changelog" rows="3" placeholder="v1.0.0 - Initial Release" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)] resize-y"></textarea>
        </div>
    </div>
</section>
