<!-- ================= Project Details ================= -->

<section class="border-t border-slate-800 pt-10">

    <div class="mb-8">

        <h2 class="text-3xl font-bold text-white">

             Project Details

        </h2>

        <p class="text-slate-400 mt-2">

            Explain everything buyers need to know before purchasing.

        </p>

    </div>

    <div class="space-y-8">

        <!-- Detailed Description -->

        <div>

            <label class="block text-slate-300 mb-3">

                Detailed Description

            </label>

            <textarea
                name="description"
                rows="8"
                required
                placeholder="Write a complete description of your project..."
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-blue-500 outline-none resize-y"></textarea>

        </div>

        <!-- Features -->

        <div>

            <label class="block text-slate-300 mb-3">

                Key Features

            </label>

            <textarea
                name="features"
                rows="5"
                placeholder="Example:

• JWT Authentication
• Admin Dashboard
• Payment Integration
• Responsive UI"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-cyan-500 outline-none resize-y"></textarea>

        </div>

        <!-- Installation -->

        <div>

            <label class="block text-slate-300 mb-3">

                Installation Guide

            </label>

            <textarea
                name="installation"
                rows="5"
                placeholder="Example:

1. npm install
2. Create .env
3. npm run dev"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-green-500 outline-none resize-y"></textarea>

        </div>

        <!-- Requirements -->

        <div class="grid md:grid-cols-2 gap-6">

            <div>

                <label class="block text-slate-300 mb-3">

                    Requirements

                </label>

                <textarea
                    name="requirements"
                    rows="4"
                    placeholder="Node.js v22+, MongoDB, Redis..."
                    class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-purple-500 outline-none"></textarea>

            </div>

            <div>

                <label class="block text-slate-300 mb-3">

                    What's Included

                </label>

                <textarea
                    name="included"
                    rows="4"
                    placeholder="Source Code, Documentation, Database..."
                    class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-pink-500 outline-none"></textarea>

            </div>

        </div>

        <!-- Version -->

        <div class="grid md:grid-cols-2 gap-6">

            <div>

                <label class="block text-slate-300 mb-3">

                    Current Version

                </label>

                <input
                    type="text"
                    name="version"
                    placeholder="v1.0.0"
                    class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-yellow-500 outline-none">

            </div>

            <div>

                <label class="block text-slate-300 mb-3">

                    Last Updated

                </label>

                <input
                    type="date"
                    name="lastUpdated"
                    class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-yellow-500 outline-none">

            </div>

        </div>

        <!-- Changelog -->

        <div>

            <label class="block text-slate-300 mb-3">

                Changelog

            </label>

            <textarea
                name="changelog"
                rows="5"
                placeholder="v1.0.0 - Initial Release"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-orange-500 outline-none resize-y"></textarea>

        </div>

    </div>

</section>