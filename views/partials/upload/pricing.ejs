<!-- ================= Pricing & License ================= -->

<section class="border-t border-slate-800 pt-10">

    <div class="mb-8">

        <h2 class="text-3xl font-bold text-white">

            💰 Pricing & License

        </h2>

        <p class="text-slate-400 mt-2">

            Set your project's pricing and licensing details.

        </p>

    </div>

    <div class="grid md:grid-cols-2 gap-6">

        <!-- Price -->

        <div>

            <label class="block text-slate-300 mb-3">

                Selling Price (₹)

            </label>

            <input
                type="number"
                name="price"
                required
                min="0"
                placeholder="999"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-blue-500 outline-none">

        </div>

        <!-- Discount -->

        <div>

            <label class="block text-slate-300 mb-3">

                Discount (%)

            </label>

            <input
                type="number"
                name="discount"
                min="0"
                max="100"
                value="0"
                placeholder="10"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-cyan-500 outline-none">

        </div>

        <!-- License -->

        <div>

            <label class="block text-slate-300 mb-3">

                License

            </label>

            <select
                name="license"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-green-500 outline-none">

                <option>Single Use</option>
                <option>Commercial</option>
                <option>Extended Commercial</option>
                <option>Enterprise</option>

            </select>

        </div>

        <!-- Support -->

        <div>

            <label class="block text-slate-300 mb-3">

                Support Duration

            </label>

            <select
                name="support"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-purple-500 outline-none">

                <option>No Support</option>
                <option>3 Months</option>
                <option>6 Months</option>
                <option>12 Months</option>

            </select>

        </div>

        <!-- Refund -->

        <div>

            <label class="block text-slate-300 mb-3">

                Refund Policy

            </label>

            <select
                name="refundPolicy"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-pink-500 outline-none">

                <option>No Refund</option>
                <option>7 Days</option>
                <option>14 Days</option>

            </select>

        </div>

        <!-- Availability -->

        <div>

            <label class="block text-slate-300 mb-3">

                Visibility

            </label>

            <select
                name="visibility"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-yellow-500 outline-none">

                <option>Public</option>
                <option>Private Draft</option>

            </select>

        </div>

    </div>

    <!-- Info Card -->

    <div class="mt-8 rounded-2xl border border-blue-500/20 bg-blue-500/10 p-6">

        <h3 class="text-xl font-semibold text-blue-400">

            💡 Pricing Tip

        </h3>

        <p class="text-slate-300 mt-3 leading-7">

            Projects with complete documentation, clean code, screenshots,
            installation guides, and demo videos generally perform better and
            build more trust with buyers.

        </p>

    </div>

</section>