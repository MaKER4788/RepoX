<section>
    <div class="mb-6">
        <h2 class="text-lg font-semibold">Basic Information</h2>
        <p class="text-[#a1a1a1] text-sm mt-1">Tell buyers what your project is about.</p>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
        <div class="md:col-span-2">
            <label class="block text-[#a1a1a1] text-sm mb-1">Project Title</label>
            <input type="text" name="title" value="<%= project ? project.title : '' %>" required placeholder="e.g. AI Resume Builder" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)] transition">
        </div>
        <div class="md:col-span-2">
            <label class="block text-[#a1a1a1] text-sm mb-1">Short Description</label>
            <textarea name="shortDescription" rows="3" placeholder="Briefly describe your project..." class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)] transition resize-none"><%= project ? project.shortDescription : '' %></textarea>
        </div>
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-1">Category</label>
            <select name="category" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 outline-none focus:border-[oklch(0.55_0.19_255)]">
                <option value="AI / Machine Learning" <%= project && project.category === "AI / Machine Learning" ? "selected" : "" %>>AI / Machine Learning</option>
                <option value="Web Development" <%= project && project.category === "Web Development" ? "selected" : "" %>>Web Development</option>
                <option value="Mobile App" <%= project && project.category === "Mobile App" ? "selected" : "" %>>Mobile App</option>
                <option value="SaaS" <%= project && project.category === "SaaS" ? "selected" : "" %>>SaaS</option>
                <option value="E-Commerce" <%= project && project.category === "E-Commerce" ? "selected" : "" %>>E-Commerce</option>
                <option value="Developer Tools" <%= project && project.category === "Developer Tools" ? "selected" : "" %>>Developer Tools</option>
                <option value="Data & Analytics" <%= project && project.category === "Data & Analytics" ? "selected" : "" %>>Data & Analytics</option>
                <option value="Automation" <%= project && project.category === "Automation" ? "selected" : "" %>>Automation</option>
                <option value="Games" <%= project && project.category === "Games" ? "selected" : "" %>>Games</option>
            </select>
        </div>
        <div class="md:col-span-2">
            <label class="block text-[#a1a1a1] text-sm mb-1">Tech Stack</label>
            <input type="text" name="techStack" value="<%= project ? project.techStack.join(', ') : '' %>" placeholder="React, Node.js, Express, MongoDB..." class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)]">
            <p class="text-xs text-neutral-500 mt-1">Separate technologies with commas.</p>
        </div>
        <div class="md:col-span-2">
            <label class="block text-[#a1a1a1] text-sm mb-1">Tags</label>
            <input type="text" name="tags" value="<%= project ? project.tags.join(', ') : '' %>" placeholder="AI, MERN, Authentication, Dashboard" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)]">
            <p class="text-xs text-neutral-500 mt-1">These tags help users find your project faster.</p>
        </div>
    </div>
</section>
