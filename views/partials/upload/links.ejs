<section class="border-t border-white/10 pt-6">
    <div class="mb-6">
        <h2 class="text-lg font-semibold">External Links</h2>
        <p class="text-[#a1a1a1] text-sm mt-1">Help buyers explore your project before purchasing.</p>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-1">Live Demo URL</label>
            <input type="url" name="liveDemo" placeholder="https://your-demo.vercel.app" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)]">
        </div>
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-1">GitHub Repository</label>
            <input type="url" name="github" placeholder="https://github.com/username/project" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)]">
        </div>
        <div>
            <label class="block text-[#a1a1a1] text-sm mb-1">Support Email</label>
            <input type="email" name="supportEmail" placeholder="support@example.com" class="w-full px-4 py-2.5 rounded-lg bg-neutral-800 border-white/10 border border-solid text-sm text-neutral-50 placeholder-[#a1a1a1] outline-none focus:border-[oklch(0.55_0.19_255)]">
        </div>
    </div>
</section>
