<!-- ================= External Links ================= -->

<section class="border-t border-slate-800 pt-10">

    <div class="mb-8">

        <h2 class="text-3xl font-bold text-white">

             External Links

        </h2>

        <p class="text-slate-400 mt-2">

            Help buyers explore your project before purchasing.

        </p>

    </div>

    <div class="grid md:grid-cols-2 gap-6">

        <!-- Live Demo -->

        <div>

            <label class="block text-slate-300 mb-3">

                Live Demo URL

            </label>

            <input
                type="url"
                name="liveDemo"
                placeholder="https://your-demo.vercel.app"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-blue-500 outline-none">

        </div>

        <!-- GitHub -->

        <div>

            <label class="block text-slate-300 mb-3">

                GitHub Repository (Optional)

            </label>

            <input
                type="url"
                name="github"
                placeholder="https://github.com/username/project"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-cyan-500 outline-none">

        </div>

        <!-- Documentation -->

        <div>

            <label class="block text-slate-300 mb-3">

                Documentation URL

            </label>

            <input
                type="url"
                name="documentationUrl"
                placeholder="https://docs.example.com"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-green-500 outline-none">

        </div>

        <!-- Video -->

        <div>

            <label class="block text-slate-300 mb-3">

                Demo Video URL

            </label>

            <input
                type="url"
                name="videoUrl"
                placeholder="https://youtube.com/watch?v=..."
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-red-500 outline-none">

        </div>

        <!-- Discord -->

        <div>

            <label class="block text-slate-300 mb-3">

                Discord / Community Link

            </label>

            <input
                type="url"
                name="discord"
                placeholder="https://discord.gg/..."
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-indigo-500 outline-none">

        </div>

        <!-- Support Email -->

        <div>

            <label class="block text-slate-300 mb-3">

                Support Email

            </label>

            <input
                type="email"
                name="supportEmail"
                placeholder="support@example.com"
                class="w-full px-5 py-4 rounded-xl bg-slate-950 border border-slate-700 focus:border-yellow-500 outline-none">

        </div>

    </div>

    <!-- Notice -->

    <div class="mt-8 rounded-2xl border border-cyan-500/20 bg-cyan-500/10 p-6">

        <h3 class="text-xl font-semibold text-cyan-400">

             Pro Tip

        </h3>

        <p class="text-slate-300 mt-3 leading-7">

            Projects with a live demo, documentation, and demo video usually
            receive significantly more views and higher conversion rates.

        </p>

    </div>

</section>