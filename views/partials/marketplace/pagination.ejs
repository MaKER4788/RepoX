<div class="flex flex-wrap justify-center items-center gap-3 mt-10 pb-16">

<% if(page>1){ %>

<a href="?page=<%= page-1 %>" class="px-4 py-2 rounded-xl border border-slate-700 text-slate-300 hover:border-blue-500 hover:text-white transition">Previous</a>

<% } %>

<% for(let i=1;i<=totalPages;i++){ %>

<a href="?page=<%= i %>" class="px-4 py-2 rounded-xl <%= i===page ? 'bg-blue-600 text-white' : 'border border-slate-700 text-slate-300 hover:border-blue-500 hover:text-white transition' %>"><%= i %></a>

<% } %>

<% if(page<totalPages){ %>

<a href="?page=<%= page+1 %>" class="px-4 py-2 rounded-xl border border-slate-700 text-slate-300 hover:border-blue-500 hover:text-white transition">Next</a>

<% } %>

</div>
