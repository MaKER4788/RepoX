<% if(totalPages > 1){ %>
<div class="flex mt-6 justify-center items-center gap-2">
    <% if(page > 1){ %>
    <a href="/marketplace?page=<%= page - 1 %>&search=<%= search %>&category=<%= category %>&sort=<%= sort %>" class="rounded-md bg-neutral-900 text-[#a1a1a1] text-sm leading-5 border-white/10 border border-solid flex px-3 items-center gap-1 h-9 hover:text-neutral-50 transition">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Prev
    </a>
    <% } %>
    <% for(var i = 1; i <= totalPages; i++){ %>
    <a href="/marketplace?page=<%= i %>&search=<%= search %>&category=<%= category %>&sort=<%= sort %>" class="size-9 <%= i === page ? 'bg-[oklch(0.55_0.15_255)] text-white' : 'bg-neutral-900 text-[#a1a1a1] border-white/10 border border-solid' %> font-medium rounded-md text-sm leading-5 flex justify-center items-center hover:opacity-90 transition"><%= i %></a>
    <% } %>
    <% if(page < totalPages){ %>
    <a href="/marketplace?page=<%= page + 1 %>&search=<%= search %>&category=<%= category %>&sort=<%= sort %>" class="rounded-md bg-neutral-900 text-[#a1a1a1] text-sm leading-5 border-white/10 border border-solid flex px-3 items-center gap-1 h-9 hover:text-neutral-50 transition">
        Next
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </a>
    <% } %>
</div>
<% } %>
