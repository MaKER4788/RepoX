<section class="max-w-7xl mx-auto px-6 py-8">
    <% if(projects.length === 0){ %>
    <div class="text-center py-20 rounded-xl border-white/10 border border-solid bg-neutral-900">
        <h2 class="text-xl font-semibold">No projects found</h2>
        <p class="text-[#a1a1a1] text-sm mt-2">Try changing your filters or search query.</p>
        <a href="/marketplace" class="inline-block mt-4 px-4 py-2 rounded-lg bg-neutral-800 text-sm border-white/10 border border-solid hover:border-white/20 transition">Clear Filters</a>
    </div>
    <% } else { %>
    <p class="text-[#a1a1a1] text-sm mb-4"><%= projects.length %> projects</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% projects.forEach(function(project){ %>
            <%- include("projectCard",{project}) %>
        <% }) %>
    </div>
    <% } %>
</section>
