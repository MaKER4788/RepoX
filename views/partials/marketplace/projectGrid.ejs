<% if(projects && projects.length){ %>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% projects.forEach(function(project){ %>
    <%- include("projectCard", {project: project}) %>
    <% }) %>
</div>
<% } else { %>
<div class="flex flex-col items-center justify-center py-20 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#525252" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-4"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <p class="text-[#a1a1a1] text-sm leading-5 mb-1">No projects found</p>
    <p class="text-[#a1a1a1] text-xs leading-4">Try adjusting your search or filters</p>
</div>
<% } %>
