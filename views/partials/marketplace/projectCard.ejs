<div class="transition-colors rounded-lg bg-neutral-900 border-white/10 border-0 border-solid p-0 gap-0 overflow-hidden flex flex-col">
    <div class="relative aspect-video bg-neutral-800 overflow-hidden">
        <% if(project.thumbnail){ %>
        <img alt="<%= project.title %>" class="size-full object-cover" src="<%= mediaUrl(project.thumbnail) %>">
        <% } else { %>
        <div class="size-full flex justify-center items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#525252" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        </div>
        <% } %>
        <button class="size-8 backdrop-blur rounded-md bg-neutral-900/80 border-white/10 border border-solid flex absolute right-2 top-2 justify-center items-center text-neutral-50 hover:text-red-400 transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </button>
    </div>
    <div class="flex p-3 flex-col gap-2 flex-1">
        <div class="flex justify-between items-start gap-2">
            <a href="/project/<%= project._id %>" class="leading-tight font-semibold text-sm leading-5 hover:text-[oklch(0.65_0.16_255)] transition"><%= project.title %></a>
        </div>
        <p class="line-clamp-2 text-[#a1a1a1] text-xs leading-4"><%= project.shortDescription || '' %></p>
        <div class="flex flex-wrap gap-1.5">
            <% if(project.techStack && project.techStack.length){ %>
            <% project.techStack.slice(0,3).forEach(function(t){ %>
            <span class="font-medium rounded-sm bg-neutral-800 text-[#a1a1a1] text-[10px] border-white/10 border-0 border-solid px-1.5 py-0"><%= t %></span>
            <% }) %>
            <% } %>
        </div>
        <div class="text-[#a1a1a1] text-xs leading-4 flex items-center gap-1.5">
            <span class="size-4 rounded-full bg-neutral-800 flex justify-center items-center text-[8px]"><%= project.owner && project.owner.username ? project.owner.username.charAt(0).toUpperCase() : '?' %></span>
            by <%= project.owner && project.owner.username ? project.owner.username : 'Unknown' %>
        </div>
        <div class="border-white/10 border-t border-r-0 border-b-0 border-l-0 border-solid flex mt-1 pt-2 justify-between items-center">
            <span class="font-bold text-base leading-6"><%= project.discount && project.discount > 0 ? '₹' + (project.price - project.discount) : (project.price === 0 ? 'Free' : '₹' + project.price) %></span>
            <button class="font-medium rounded-md bg-neutral-800 text-neutral-50 text-xs leading-4 px-2.5 gap-1 h-8 flex items-center hover:bg-neutral-700 transition">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                Cart
            </button>
        </div>
    </div>
</div>
