
<div
    class="group rounded-3xl overflow-hidden border border-slate-800 bg-slate-900 hover:border-blue-500 transition duration-300 hover:-translate-y-2">

    <!-- Thumbnail -->

    <div class="relative overflow-hidden h-36">

       <img
            src="<%= mediaUrl(project.thumbnail) %>"
            alt="<%= project.title %>"
            class="w-full h-full object-cover">

        <span
            class="absolute top-4 left-4 bg-blue-600 text-white text-xs font-semibold px-3 py-1 rounded-full">

            <%= project.category %>

        </span>

    </div>

    <!-- Content -->

    <div class="p-6">

        <h2 class="text-2xl font-bold text-white mb-2">

            <%= project.title %>

        </h2>

        <p class="text-slate-400 text-sm line-clamp-2 mb-5">

            <%= project.shortDescription || project.description %>

        </p>

        <!-- Tech Stack -->

        <div class="flex flex-wrap gap-2 mb-5">

           <% if(project.techStack && project.techStack.length){ %>

    <% project.techStack.slice(0,3).forEach(tech => { %>

        <span
            class="px-3 py-1 rounded-full bg-slate-800 text-slate-300 text-xs">

            <%= tech %>

        </span>

    <% }) %>

<% } %>

        </div>

        <!-- Bottom -->

        <div class="flex justify-between items-center">

            <div>

                <p class="text-slate-500 text-xs">

                    Seller

                </p>

                <p class="text-white font-medium">

                    <%= project.owner.username %>

                </p>

            </div>

            <div class="text-right">

                <p class="text-2xl font-bold text-green-400">

                    ₹<%= project.price %>

                </p>

            </div>

        </div>

        <!-- Button -->

        <a
            href="/projects/<%= project._id %>"
            class="mt-6 block w-full text-center py-3 rounded-xl bg-blue-600 hover:bg-blue-700 transition font-semibold">

            View Project →

        </a>

    </div>

</div>